# =============================================================================
# DGIAESG — Variables d'environnement (référence unique)
#
# Usage :
#   • Local : copie les blocs vers frontend/.env.local et backend/.env
#   • Vercel : crée les MÊMES clés dans Settings → Environment Variables
#     (Production / Preview selon le besoin). Les VITE_* = au moment du build.
#   • Ne commite jamais de vrais secrets (garde ce fichier sans mots de passe).
# =============================================================================


# ---------------------------------------------------------------------------
# FRONTEND (Vite) — préfixe obligatoire VITE_
# Intégré au build : redéployer le front après chaque changement.
# ---------------------------------------------------------------------------

# Développement local (proxy Vite → backend :5000, voir vite.config.ts)
VITE_API_URL=http://localhost:5000/api

# Vercel — un seul projet (api/ à la racine + rewrites → /api)
# Remplace YOUR_PROJECT par ton domaine .vercel.app (ex. dgiaesg).
# VITE_API_URL=https://YOUR_PROJECT.vercel.app/api

# Vercel — deux projets séparés (front + API sur deux URLs)
# VITE_API_URL=https://your-backend-xxxxx.vercel.app/api


# ---------------------------------------------------------------------------
# BACKEND (Express / serverless Vercel)
# ---------------------------------------------------------------------------

NODE_ENV=development

# Port local uniquement ; sur Vercel la plateforme définit souvent PORT elle-même.
PORT=5000

# MongoDB (obligatoire — même format qu’Atlas)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority

# JWT (auth) — obligatoire en production, jamais la valeur par défaut "secret"
JWT_SECRET=change-me-use-a-long-random-string-at-least-32-chars


# ---------------------------------------------------------------------------
# Automatique — ne pas définir sur Vercel / local
# ---------------------------------------------------------------------------
# VERCEL=1   → injecté par Vercel sur les fonctions serverless
