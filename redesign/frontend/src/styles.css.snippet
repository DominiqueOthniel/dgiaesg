/* ----------------------------------------------------------------------
 * Snippet to MERGE into frontend/src/styles.css (do NOT replace the file).
 *
 * Purpose: ensure the app fills the entire viewport on every screen size.
 * Add the html/body block inside your existing `@layer base { ... }`.
 * ---------------------------------------------------------------------- */

@layer base {
  html,
  body {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  body {
    overflow-x: hidden;
  }
}
